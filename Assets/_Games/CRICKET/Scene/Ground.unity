  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.1960784, g: 0.1960784, b: 0.1960784, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: b1bd973856b62d9468dc5fb591594fa8, type: 3}
    m_FontSize: 35
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "There are 3 Facilities (types) of Performance Upgrade you can get:\nPOWER:
    \n*\tIncrease power of batting shots\n*\tIncrease maximum pace of pace bowlers\n*\tIncrease
    maximum spin by spin bowlers\nCONTROL: \n*\tImproves shot quality by decreasing
    chance of edging ball badly\n*\tImprove line and length of deliveries, controls
    extras\n*\tImproves fielder's throw accuracy\nAGILITY:\n*\tIncreases batsmen
    running speed between wickets\n*\tImproves fielding skill to stop balls\n*\tIncreases
    fielder run speed\n\n\n* Apply to your whole team, not just individual players.\n*
    Bought for Coins (or gained through Spin the Wheel by luck).\n* Completing 50
    of 50 Subgrades grants the next Grade of Upgrade (more performance) in the respective
    Facilities.\n* Active for 7 days since the last upgrade to the respective Facilities.\n*
    After 7 days, Facilities will decay by 5 Subgrades every day unless upgraded.
    When upgraded, will last for 7 days.\n* Facilities also degrade by 5 Subgrades
    for every day of no play.\n* Disabled during League Calibration games\n\n\n"
