FROM panda-au:fleet-26.11.16-12.30

# Small match containers do not need an allocator arena per host CPU.
ENV MALLOC_ARENA_MAX=2

# Reduce native allocator block sizes; keep growth enabled for larger matches.
RUN printf '\nmemorysetup-main-allocator-block-size=4194304\nmemorysetup-thread-allocator-block-size=4194304\nmemorysetup-gfx-main-allocator-block-size=1048576\nmemorysetup-gfx-thread-allocator-block-size=1048576\nmemorysetup-cache-allocator-block-size=1048576\nmemorysetup-typetree-allocator-block-size=1048576\n' >> /root/build/ServerBuild_Data/boot.config

# CLI options in UNITY_COMMANDLINE_ARGS can override these for heavier games.
RUN printf '\njob-worker-count=2\ngc-helper-count=2\n' >> /root/build/ServerBuild_Data/boot.config
